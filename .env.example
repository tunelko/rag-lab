# Copy to .env or use Configurar.ps1 / configurar.sh.
# Embeddings stay on CPU; Ollama manages generation and its own GPU runtime.
RAG_SETUP_PROFILE=ollama
RAG_GENERATION_PROVIDER=ollama
RAG_EXTERNAL_MODEL=
RAG_WEB_PORT=8765
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_EMBEDDING_DEVICE=cpu
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=4
RAG_CONTEXT_CHARS=12000
RAG_COLLECTION=documents
RAG_BACKEND=ollama
RAG_OLLAMA_URL=http://127.0.0.1:11434
# Choose the exact name of an installed LOCAL model in the wizard.
RAG_OLLAMA_MODEL=
# Set a compatible model ID or local directory before using the HF backend.
RAG_HF_MODEL=
RAG_HF_MAX_MEMORY_GIB=7
RAG_MAX_NEW_TOKENS=512
# Reasoning models share this budget between thinking and the visible answer.
RAG_REASONING_MAX_NEW_TOKENS=2048
RAG_OLLAMA_VISION_CONTEXT=8192
RAG_OLLAMA_GLOBAL_CONTEXT=8192
RAG_GLOBAL_MAX_NEW_TOKENS=2048

# Optional local cross-encoder that reorders focused-question candidates.
# It must already be in the local model cache; the service never downloads it.
# GPU: BAAI/bge-reranker-v2-m3. CPU: cross-encoder/mmarco-mMiniLMv2-L12-H384-v1.
RAG_RERANKER=
RAG_RERANK_WINDOW=50
RAG_RERANK_DEVICE=auto
RAG_RERANK_HALF=1
