# Copy to .env or use Configurar.ps1 / configurar.sh.
# Embeddings stay on CPU; Ollama manages generation and its own GPU runtime.
RAG_SETUP_PROFILE=ollama
RAG_WEB_PORT=8765
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_EMBEDDING_DEVICE=cpu
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=4
RAG_CONTEXT_CHARS=12000
RAG_COLLECTION=documents
RAG_BACKEND=ollama
RAG_OLLAMA_URL=http://127.0.0.1:11434
# Choose the exact name of an installed LOCAL model in the wizard.
RAG_OLLAMA_MODEL=
# Set a compatible model ID or local directory before using the HF backend.
RAG_HF_MODEL=
RAG_HF_MAX_MEMORY_GIB=7
RAG_MAX_NEW_TOKENS=512
RAG_OLLAMA_VISION_CONTEXT=8192
