# Environments, caches and local configuration
.venv/
.cache/
__pycache__/
*.pyc
.env
.env.*
!.env.example

# Private runtime data: documents, indexes, settings and backups
/data/*
!/data/documents/
/data/documents/*
!/data/documents/.gitkeep
/reports/
/datasets/
/install-*.json
/web/runtime-console.json
*.log
*.pending
*.gguf
*.safetensors

# User-supplied commercial fonts stay local and are never published
/web/design/fonts/pangram/
